rules_version = '2';

// Firebase Storage rules for Prism. Deploy with:  firebase deploy --only firestore:rules,storage
//   avatars/{uid}/…    profile photos        (written by that user)
//   articles/{uid}/…   cover + inline images (written by that user)
//   audiobooks/{uid}/… author-narrated audiobook editions (written by that user)
// Files are readable by exact path (they appear on public profiles and stories); folders can't be listed.
// Image uploads: the owner's own folder only, ≤ 5 MB, JPEG/PNG/WebP with a matching extension.
// Audio uploads: the owner's own folder only, < 50 MB, MP3/WAV/M4A/OGG (plus WebM/MP4 from in-browser recording).
// Keep in step with src/lib/storage.ts and src/lib/audiobook.ts.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ayushra6111@gmail.com', 'surishri03@gmail.com'];
    }
    function ownImage(uid, file) {
      return request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && file.lower().matches('.+\\.(jpe?g|png|webp)$');
    }

    function ownAudio(uid, file) {
      return request.auth != null && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp3|wav|x-wav|wave|vnd[.]wave|mp4|x-m4a|m4a|aac|ogg|webm)')
        && file.lower().matches('.+[.](mp3|wav|m4a|ogg|webm|mp4)$');
    }

    // Reads are by exact path only: listing a folder is closed, so nobody can enumerate other people's
    // recordings or images (audit F-14). A locked voice post's URL is only handed out by the server.
    // Uploads are create-only: a file a reviewer approved can't be swapped afterwards (audit F-13).
    // Every upload gets a fresh timestamped name (src/lib/storage.ts, src/lib/audiobook.ts).
    match /audiobooks/{uid}/{file} {
      allow get: if true;
      allow list: if false;
      allow create: if ownAudio(uid, file);
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
    match /avatars/{uid}/{file} {
      allow get: if true;
      allow list: if false;
      allow create: if ownImage(uid, file);
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
    match /articles/{uid}/{file} {
      allow get: if true;
      allow list: if false;
      allow create: if ownImage(uid, file);
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
    // Everything else is closed
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
