# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
# Replace with your Supabase Transaction Pooler connection string:
# e.g. postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prism?schema=public"

# Direct URL for migrations (if using connection pooling):
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prism?schema=public"

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Phase 1 AI-content check (optional) ───────────────────────────────────────
# Without these, articles are scored by the built-in heuristic detector only.
# With them, the external score is blended with the heuristic one (70/30).
# The endpoint receives POST { text } and may answer with ai_probability, score,
# or GPTZero's documents[0].completely_generated_prob (0-1 or 0-100).
AI_DETECTION_API_URL=""
AI_DETECTION_API_KEY=""
AI_DETECTION_PROVIDER="external"

# ── Avatar storage (optional) ─────────────────────────────────────────────────
# With SUPABASE_SERVICE_ROLE_KEY set, avatars upload to this public Storage bucket;
# otherwise they are returned as inline data URIs.
AVATAR_BUCKET="avatars"

# ── Elite tier ────────────────────────────────────────────────────────────────
# Prices, RPM, panel size and badge thresholds live in src/lib/elite/config.ts.
# Payment provider for Elite checkout: "mock" (default, activates instantly — never use
# in production), "stripe" or "razorpay". Webhooks: POST /api/elite/webhook.
ELITE_PAYMENT_PROVIDER="mock"
ELITE_WEBHOOK_SECRET=""
# Set to "database" when DATABASE_URL + Supabase auth are configured, so article views
# are also sent to POST /api/articles/[id]/views (dedupe + wallet credit server-side).
NEXT_PUBLIC_DATA_MODE="demo"
# Salt for hashing signed-out readers' IP + user agent into a view fingerprint
VIEW_FINGERPRINT_SALT=""
# Show the dev role switcher in production builds
NEXT_PUBLIC_DEV_TOOLS="false"
