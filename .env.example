# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
# Replace with your Supabase Transaction Pooler connection string:
# e.g. postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prism?schema=public"

# Direct URL for migrations (if using connection pooling):
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prism?schema=public"

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

