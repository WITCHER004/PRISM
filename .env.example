# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
# Replace with your Supabase Transaction Pooler connection string:
# e.g. postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prism?schema=public"

# Direct URL for migrations (if using connection pooling):
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prism?schema=public"

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Phase 1 AI-content check (optional) ───────────────────────────────────────
# Without these, articles are scored by the built-in heuristic detector only.
# Recommended: run ai_plagiarism_engine/ (calibrated transformer ensemble + semantic plagiarism)
# and point this at its /evaluate endpoint, e.g. "https://engine.internal/evaluate", with the
# engine's ENGINE_API_KEY. Its report is used as-is and published stories are indexed via /index.
# Any other detection API (answering ai_probability, score, or GPTZero's
# documents[0].completely_generated_prob) is blended 70/30 with the heuristic.
AI_DETECTION_API_URL=""
AI_DETECTION_API_KEY=""
AI_DETECTION_PROVIDER="external"
# The engine runs transformer models; allow it time on long articles
AI_DETECTION_TIMEOUT_MS="60000"

# ── Avatar storage (optional) ─────────────────────────────────────────────────
# With SUPABASE_SERVICE_ROLE_KEY set, avatars upload to this public Storage bucket;
# otherwise they are returned as inline data URIs.
AVATAR_BUCKET="avatars"

# ── Elite tier ────────────────────────────────────────────────────────────────
# Prices, RPM, panel size and badge thresholds live in src/lib/elite/config.ts.
# Payment provider for Elite checkout: "mock" (default, activates instantly — never use
# in production), "stripe" or "razorpay". Webhooks: POST /api/elite/webhook.
ELITE_PAYMENT_PROVIDER="mock"
ELITE_WEBHOOK_SECRET=""
# Set to "database" when DATABASE_URL + Supabase auth are configured, so article views
# are also sent to POST /api/articles/[id]/views (dedupe + wallet credit server-side).
NEXT_PUBLIC_DATA_MODE="demo"
# Salt for hashing signed-out readers' IP + user agent into a view fingerprint
VIEW_FINGERPRINT_SALT=""
# Show the dev role switcher in production builds
NEXT_PUBLIC_DEV_TOOLS="false"

# ── Firebase Authentication & Config ───────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDO4D8Ho1I-5QosfIp6ppe6jQcrPeIbQn8"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="prism-2d284.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="prism-2d284"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="prism-2d284.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="264786801070"
NEXT_PUBLIC_FIREBASE_APP_ID="1:264786801070:web:464f23895c405eb974583f"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-9TGPS0XGJN"

# ── Elite payments ────────────────────────────────────────────────────────────
# "stripe" or "razorpay" in production. Anything else means mock payments, which grant Elite
# without charging: they only work outside production unless this escape hatch is "true".
ELITE_PAYMENT_PROVIDER=""
ELITE_ALLOW_MOCK_CHECKOUT=""
